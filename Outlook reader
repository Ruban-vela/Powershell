$outlook = New-Object -ComObject Outlook.Application
$selection = $outlook.ActiveExplorer().Selection

if ($selection.Count -eq 0) {
    Write-Warning "Please select the email in Outlook first."
    Exit
}

$mail = $selection.Item(1)
$htmlDoc = New-Object -ComObject "HTMLFile"
$htmlDoc.IHTMLDocument2_write($mail.HTMLBody)

$tables = $htmlDoc.getElementsByTagName("table")
$records = @()

foreach ($table in $tables) {
    # 1. Identify heading
    $heading = "General Task"
    $sibling = $table.previousSibling
    while ($sibling) {
        $text = $sibling.innerText
        if (-not [string]::IsNullOrWhiteSpace($text) -and $text -match "TASK|Python|SCCM|Repair") {
            $heading = ($text -replace '\s+', ' ').Trim()
            break
        }
        $sibling = $sibling.previousSibling
    }

    $rows = $table.rows
    if ($rows.length -lt 2) { continue }

    # 2. Extract this table's exact column names
    $headers = @()
    for ($c = 0; $c -lt $rows.item(0).cells.length; $c++) {
        $name = ($rows.item(0).cells.item($c).innerText -replace '\s+', ' ').Trim()
        $headers += $name
    }

    # Find the Executor index dynamically
    $execIdx = -1
    for ($i = 0; $i -lt $headers.Count; $i++) {
        if ($headers[$i] -match "(?i)executor") { 
            $execIdx = $i 
            break 
        }
    }

    if ($execIdx -eq -1) { continue }

    # 3. Build key-value pairs
    for ($r = 1; $r -lt $rows.length; $r++) {
        $cells = $rows.item($r).cells
        if ($cells.length -gt $execIdx) {
            $executor = ($cells.item($execIdx).innerText -replace '\s+', ' ').Trim()
            
            if (-not [string]::IsNullOrWhiteSpace($executor)) {
                $rowObj = [ordered]@{
                    "Heading"           = $heading
                    "Executor_Assigned" = $executor
                }

                # Dynamically assign each cell to its column header
                for ($c = 0; $c -lt $cells.length; $c++) {
                    $headerKey = if ($c -lt $headers.Count) { $headers[$c] } else { "Col_$c" }
                    $rowObj[$headerKey] = ($cells.item($c).innerText -replace '\s+', ' ').Trim()
                }

                $records += [PSCustomObject]$rowObj
            }
        }
    }
}

# View output in a GUI window
$records | Out-GridView -Title "Tasks Normalized Across Tables"

# Filter by an executor, e.g., 'rajesh'
$records | Where-Object { $_.Executor_Assigned -match "rajesh" } | Format-Table Heading, "Server Name", Shift, "IST Start Time", "Mexico Start Time"

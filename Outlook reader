$outlook = New-Object -ComObject Outlook.Application
$selection = $outlook.ActiveExplorer().Selection

if ($selection.Count -eq 0) {
    Write-Warning "Please select the email in Outlook first."
    Exit
}

$mail = $selection.Item(1)
$htmlDoc = New-Object -ComObject "HTMLFile"
$htmlDoc.IHTMLDocument2_write($mail.HTMLBody)

$tables = $htmlDoc.getElementsByTagName("table")
$allRecords = @()
$tableCounter = 0

foreach ($table in $tables) {
    $tableCounter++
    
    # 1. Search backwards for heading
    $heading = ""
    $sibling = $table.previousSibling
    while ($sibling) {
        $text = $sibling.innerText
        if (-not [string]::IsNullOrWhiteSpace($text) -and ($text -match "TASK|BIOS|Manual|Remediation|Patch|TCM|Change|Python|SCCM")) {
            $heading = ($text -replace '\s+', ' ').Trim()
            break
        }
        $sibling = $sibling.previousSibling
    }

    if ([string]::IsNullOrWhiteSpace($heading)) {
        $heading = if ($tableCounter -eq 1) { "TCM_Change_Schedule" } else { "Task_Table_$tableCounter" }
    }

    $rows = $table.rows
    if ($rows.length -lt 2) { continue }

    # 2. Extract this table's specific headers
    $headers = @()
    for ($c = 0; $c -lt $rows.item(0).cells.length; $c++) {
        $hName = ($rows.item(0).cells.item($c).innerText -replace '\s+', ' ').Trim()
        if ([string]::IsNullOrWhiteSpace($hName)) { $hName = "Col_$c" }
        $headers += $hName
    }

    # 3. Locate Executor index (handles both "Primary Executor" and "Executor")
    $execIdx = -1
    for ($i = 0; $i -lt $headers.Count; $i++) {
        if ($headers[$i] -match "(?i)executor") { 
            $execIdx = $i 
            break 
        }
    }
    if ($execIdx -eq -1) { continue }

    # 4. Extract data rows
    for ($r = 1; $r -lt $rows.length; $r++) {
        $cells = $rows.item($r).cells
        if ($cells.length -gt $execIdx) {
            $executor = ($cells.item($execIdx).innerText -replace '\s+', ' ').Trim()
            
            if (-not [string]::IsNullOrWhiteSpace($executor)) {
                $rowObj = [ordered]@{
                    "Task_Heading"      = $heading
                    "Assigned_Executor" = $executor
                }

                for ($c = 0; $c -lt $cells.length; $c++) {
                    $propKey = if ($c -lt $headers.Count) { $headers[$c] } else { "Col_$c" }
                    $rowObj[$propKey] = ($cells.item($c).innerText -replace '\s+', ' ').Trim()
                }

                $allRecords += [PSCustomObject]$rowObj
            }
        }
    }
}

# View output in a filterable grid
$allRecords | Out-GridView -Title "All Outlook Tasks"


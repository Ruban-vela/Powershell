$outlook = New-Object -ComObject Outlook.Application
$selection = $outlook.ActiveExplorer().Selection

if ($selection.Count -eq 0) {
    Write-Warning "Please select the email in Outlook first."
    Exit
}

$mail = $selection.Item(1)
$htmlDoc = New-Object -ComObject "HTMLFile"
$htmlDoc.IHTMLDocument2_write($mail.HTMLBody)

$tables = $htmlDoc.getElementsByTagName("table")
$allRecords = @()

foreach ($table in $tables) {
    # 1. Find heading above current table
    $heading = "General Task"
    $sibling = $table.previousSibling
    while ($sibling) {
        $text = $sibling.innerText
        if (-not [string]::IsNullOrWhiteSpace($text) -and $text -match "TASK|Repair|Install|Config") {
            $heading = $text.Trim()
            break
        }
        $sibling = $sibling.previousSibling
    }

    $rows = $table.rows
    if ($rows.length -lt 2) { continue }

    # 2. Extract unique headers for THIS specific table
    $currentHeaders = @()
    for ($c = 0; $c -lt $rows.item(0).cells.length; $c++) {
        $headerName = $rows.item(0).cells.item($c).innerText.Trim()
        if ([string]::IsNullOrWhiteSpace($headerName)) { $headerName = "Column_$c" }
        $currentHeaders += $headerName
    }

    # Find the Executor index dynamically
    $execIdx = -1
    for ($i = 0; $i -lt $currentHeaders.Count; $i++) {
        if ($currentHeaders[$i] -match "(?i)executor") { 
            $execIdx = $i 
            break 
        }
    }

    if ($execIdx -eq -1) { continue }

    # 3. Read data rows
    for ($r = 1; $r -lt $rows.length; $r++) {
        $cells = $rows.item($r).cells
        if ($cells.length -gt $execIdx) {
            $executor = $cells.item($execIdx).innerText.Trim()
            
            if (-not [string]::IsNullOrWhiteSpace($executor)) {
                # Dynamically construct object with standard columns first
                $rowProps = [ordered]@{
                    "Task_Heading" = $heading
                    "Executor"     = $executor
                }

                # Add each column present in this table
                for ($c = 0; $c -lt $cells.length; $c++) {
                    $propName = if ($c -lt $currentHeaders.Count) { $currentHeaders[$c] } else { "Column_$c" }
                    # Avoid overwriting Executor if it matches the header name
                    if ($propName -ne "Executor") {
                        $rowProps[$propName] = $cells.item($c).innerText.Trim()
                    }
                }

                $allRecords += [PSCustomObject]$rowProps
            }
        }
    }
}

# View all extracted rows interactively
$allRecords | Out-GridView -Title "Extracted Tasks by Executor"


param (
    [Parameter(Mandatory=$true)]
    [string]$Executor,

    [Parameter(Mandatory=$false)]
    [string]$Shift
)

# 1. Connect to Outlook
$outlook = New-Object -ComObject Outlook.Application
$selection = $outlook.ActiveExplorer().Selection

if ($selection.Count -eq 0) {
    Write-Warning "Please select the email thread in Outlook first."
    Exit
}

$selectedItem = $selection.Item(1)
$mail = $selectedItem

# 2. Guarantee we are examining the LATEST email in the conversation thread
try {
    $conv = $selectedItem.GetConversation()
    if ($conv -ne $null) {
        # Retrieve all items in the conversation and sort descending by ReceivedTime
        $threadItems = $conv.GetRootItems() | ForEach-Object { 
            $_ ; $conv.GetChildren($_) 
        } | Where-Object { $_.ReceivedTime } | Sort-Object -Property ReceivedTime -Descending

        if ($threadItems.Count -gt 0) {
            $mail = $threadItems[0]
            Write-Host "Evaluating latest message received on: $($mail.ReceivedTime)" -ForegroundColor Green
        }
    }
} catch {
    # If not part of an active conversation or Exchange store, default to the selected message
    $mail = $selectedItem
}

# 3. Truncate previous reply history from HTML body
$rawHtml = $mail.HTMLBody

# Common reply/forward divider markers inserted by Outlook and Exchange:
$replyDividerPatterns = @(
    '(?i)<div\s+id=["'']?divRplyFwdMsg["'']?',
    '(?i)<hr\b[^>]*>',
    '(?i)<div\s+style=["''][^"'']*border-top:\s*solid',
    '(?i)<b>From:</b>',
    '(?i)-----Original Message-----'
)

$cutoffIndex = $rawHtml.Length

foreach ($pattern in $replyDividerPatterns) {
    $match = [regex]::Match($rawHtml, $pattern)
    if ($match.Success -and $match.Index -lt $cutoffIndex) {
        $cutoffIndex = $match.Index
    }
}

# Slice HTML to retain only content BEFORE the first reply separator
$latestMessageHtml = if ($cutoffIndex -lt $rawHtml.Length) {
    $rawHtml.Substring(0, $cutoffIndex)
} else {
    $rawHtml
}

# 4. Load sanitized HTML into DOM
$htmlDoc = New-Object -ComObject "HTMLFile"
$htmlDoc.IHTMLDocument2_write($latestMessageHtml)

$tables = $htmlDoc.getElementsByTagName("table")

if ($tables.length -eq 0) {
    Write-Warning "No tables found in the latest message of this thread."
    Exit
}

$tableIdx = 0

# 5. Process tables from the latest message only
foreach ($table in $tables) {
    $tableIdx++

    # Heading Detection
    $heading = ""
    $sibling = $table.previousSibling
    while ($sibling) {
        $text = $sibling.innerText
        if (-not [string]::IsNullOrWhiteSpace($text)) {
            $clean = ($text -replace '\s+', ' ').Trim()
            if ($clean -notmatch "^(?i)note\b|please update|confidential info|in sheet") {
                if ($clean -match "TASK|BIOS|Manual|Remediation|Patch|TCM|Change|Python|SCCM|Install|Repair") {
                    $heading = $clean
                    break
                }
            }
        }
        $sibling = $sibling.previousSibling
    }
    if ([string]::IsNullOrWhiteSpace($heading)) {
        $heading = if ($tableIdx -eq 1) { "TCM Change Schedule" } else { "Task Table $tableIdx" }
    }

    $rows = $table.rows
    if ($rows.length -lt 2) { continue }

    # Extract Table Headers
    $headers = @()
    for ($c = 0; $c -lt $rows.item(0).cells.length; $c++) {
        $name = ($rows.item(0).cells.item($c).innerText -replace '\s+', ' ').Trim()
        if ([string]::IsNullOrWhiteSpace($name)) { $name = "Col_$c" }
        $headers += $name
    }

    # Locate Executor & Shift
    $execIdx = -1
    $shiftIdx = -1
    for ($i = 0; $i -lt $headers.Count; $i++) {
        if ($headers[$i] -match "(?i)executor") { $execIdx = $i }
        if ($headers[$i] -match "(?i)shift")    { $shiftIdx = $i }
    }

    if ($execIdx -eq -1) { continue }

    # Filter rows by Executor and Shift
    $tableMatches = @()
    for ($r = 1; $r -lt $rows.length; $r++) {
        $cells = $rows.item($r).cells
        if ($cells.length -gt $execIdx) {
            $rowExec = ($cells.item($execIdx).innerText -replace '\s+', ' ').Trim()

            if ($rowExec -like "*$Executor*") {
                
                if ($Shift -and $shiftIdx -ne -1 -and $cells.length -gt $shiftIdx) {
                    $rowShift = ($cells.item($shiftIdx).innerText -replace '\s+', ' ').Trim()
                    if ($rowShift -notlike "*$Shift*") {
                        continue
                    }
                }

                $rowObj = [ordered]@{}
                for ($c = 0; $c -lt $cells.length; $c++) {
                    $key = if ($c -lt $headers.Count) { $headers[$c] } else { "Col_$c" }
                    $rowObj[$key] = ($cells.item($c).innerText -replace '\s+', ' ').Trim()
                }

                # Ensure Server Name exists
                $hasServer = $false
                foreach ($k in $rowObj.Keys) {
                    if ($k -match "(?i)server\s*name") { $hasServer = $true; break }
                }
                if (-not $hasServer -and $rowObj.Contains("Summary")) {
                    $matches = [regex]::Matches($rowObj["Summary"], "\b[a-zA-Z]{3,7}\d{3,8}[a-zA-Z0-9]*\b")
                    if ($matches.Count -gt 0) {
                        $rowObj["Server Name"] = ($matches | ForEach-Object { $_.Value } | Select-Object -Unique) -join ", "
                    } else {
                        $rowObj["Server Name"] = $rowObj["TCM"]
                    }
                }

                $tableMatches += [PSCustomObject]$rowObj
            }
        }
    }

    # Render distinct output for this table
    if ($tableMatches.Count -gt 0) {
        Write-Host "`n========================================================" -ForegroundColor Cyan
        Write-Host "TABLE: $heading" -ForegroundColor Yellow
        Write-Host "Matched Rows: $($tableMatches.Count)" -ForegroundColor Cyan
        Write-Host "========================================================" -ForegroundColor Cyan
        
        $tableMatches | Format-Table -AutoSize
        $tableMatches | Out-GridView -Title "$heading - ($Executor) [Latest Email]"
    }
}
